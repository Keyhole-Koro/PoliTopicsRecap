{
  "name": "politopics-recap",
  "version": "1.0.0",
  "main": "index.js",
  "type": "commonjs",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "pretest": "bash scripts/ensure-localstack.sh",
    "test": "APP_ENVIRONMENT=localstackTest ENABLE_NOTIFICATION=false jest --config jest.config.ts --runInBand",
    "test:gha": "APP_ENVIRONMENT=ghaTest ENABLE_NOTIFICATION=false jest --config jest.config.ts --runInBand",
    "ensure:localstack": "bash scripts/ensure-localstack.sh",
    "dev": "npx ts-node -r tsconfig-paths/register src/local_invoke.ts",
    "local:test:e2e": "ENABLE_NOTIFICATION=false jest --config jest.config.ts --runTestsByPath tests/integration/fullFlow.test.ts",
    "build": "pnpm exec tsc && pnpm exec tsc-alias",
    "build:container": "pnpm run build",
    "batch": "APP_ENVIRONMENT=localstackTest ENABLE_NOTIFICATION=false npx ts-node -r tsconfig-paths/register src/container_main.ts",
    "batch:docker": "docker-compose run --rm app-batch",
    "batch:docker:dev": "docker-compose run --rm app-batch-dev",
    "docker:build": "docker build -t politopics-recap:local .",
    "ensure:localstack:batch": "bash scripts/ensure-localstack.sh",
    "enqueue-mock": "ts-node -r tsconfig-paths/register scripts/enqueue-mock-prompts.ts"
  },
  "author": "",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/node-fetch": "^2.6.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.817.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/client-scheduler": "^3.896.0",
    "@aws-sdk/client-sqs": "^3.864.0",
    "@aws-sdk/lib-dynamodb": "^3.817.0",
    "@google/generative-ai": "^0.24.1",
    "@keyhole-koro/politopics-notification": "latest",
    "dotenv": "^16.5.0",
    "fs-extra": "^11.3.0",
    "node-fetch": "^2.7.0"
  }
}
