FROM node:22-slim

WORKDIR /app

# Install pnpm (match packageManager in package.json)
RUN npm install -g pnpm@10.18.2

COPY package.json pnpm-lock.yaml .npmrc ./

# Install dependencies including devDependencies for testing
# Mount secret and export to env var for pnpm install
RUN --mount=type=secret,id=github_token \
    NODE_AUTH_TOKEN=$(cat /run/secrets/github_token) pnpm install --frozen-lockfile

COPY . .

# Build TypeScript
RUN pnpm run build

# Default command on container startup (run tests)
CMD ["pnpm", "test"]