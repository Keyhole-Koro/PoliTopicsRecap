aws_region                                        = "ap-northeast-3"
environment                                       = "prod"
lambda_name                                       = "politopics-recap-prod"
lambda_package_path                               = "../dist/lambda_handler.zip"
lambda_layer_package_path                         = "../dist/lambda_layer.zip"
prompt_bucket_name                                = "politopics-prod-prompts"
politopics_table_name                             = "politopics-prod"
task_table_name                                   = "LlmTasks"
task_status_index_name                            = "StatusIndex"
lambda_memory_mb                                  = 128
lambda_timeout_seconds                            = 300
lambda_reserved_concurrency                       = 1
lambda_rate_limit_rps                             = 1
lambda_rate_limit_burst                           = 1
lambda_backoff_base_seconds                       = 2
lambda_backoff_cap_seconds                        = 120
lambda_max_attempts                               = 8
lambda_api_timeout_ms                             = 30000
lambda_overall_timeout_ms                         = 60000
lambda_circuit_breaker_failure_threshold          = 10
lambda_circuit_breaker_minimum_requests           = 10
lambda_circuit_breaker_cooldown_seconds           = 120
lambda_circuit_breaker_visibility_timeout_seconds = 120
lambda_circuit_breaker_half_open_max_calls        = 2
scheduler_use_processor_lambda_as_target          = true
scheduler_start_time                              = "00:00"
scheduler_end_time                                = "01:00"
scheduler_timezone                                = "Asia/Tokyo"
scheduler_minute_step                             = 5
scheduler_cron_expression                         = null
enable_scheduler                                  = true
