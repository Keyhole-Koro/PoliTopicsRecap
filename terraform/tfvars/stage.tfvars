aws_region                               = "ap-northeast-3"
environment                              = "stage"
lambda_name                              = "politopics-recap-stage"
lambda_package_path                      = "../dist/lambda_handler.zip"
lambda_layer_package_path                = "../dist/lambda_layer.zip"
prompt_bucket_name                       = "politopics-data-collection-prompts-stage"
politopics_table_name                    = "politopics-stage"
task_table_name                          = "politopics-llm-tasks-stage"
task_status_index_name                   = "StatusIndex"
lambda_memory_mb                         = 128
lambda_timeout_seconds                   = 300
lambda_max_attempts                      = 5
lambda_api_timeout_ms                    = 30000
lambda_overall_timeout_ms                = 45000
scheduler_use_processor_lambda_as_target = true
scheduler_start_time                     = "00:00"
scheduler_end_time                       = "00:07"
scheduler_timezone                       = "Asia/Tokyo"
scheduler_minute_step                    = 5
scheduler_cron_expression                = null
enable_scheduler                         = true
